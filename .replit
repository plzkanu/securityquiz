run = "npm run dev"

hidden = [".config", ".next"]

modules = ["nodejs-22"]

[nix]
channel = "stable-24_11"

[deployment]
# GitHub main 최신 + 의존성 설치 후 프로덕션 빌드 (Republish 시 자동 실행)
build = ["npm", "run", "replit-deploy-build"]
run = ["npm", "run", "start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
