# === 로컬 PC에서만 테스트할 때 (Replit 불필요) ===
# 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채우세요.
# REPLIT_DB_URL 이 없으면 자동으로 `.data/store.json` 에 데이터가 저장됩니다.

# 필수: JWT·세션 서명 (16자 이상 권장)
AUTH_SECRET=

# 사용자가 아직 없을 때 최초 관리자 1명 자동 생성
INITIAL_ADMIN_USER=admin
# 비밀번호에 # ! 공백 등이 있으면 반드시 따옴표로 감싸세요 (# 는 따옴표 없으면 주석으로 잘립니다)
INITIAL_ADMIN_PASSWORD=
# 예: INITIAL_ADMIN_PASSWORD="admin!@#"

# === Replit 에서만 ===
# 아래는 Replit 이 주입합니다. 로컬에 수동으로 넣지 않아도 됩니다.
# REPLIT_DB_URL=
